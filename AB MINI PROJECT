# ============================================================
# 11. CONFIDENCE INTERVAL
# ============================================================

print("\n========== CONFIDENCE INTERVAL ==========")

profit = df["Profit"]

mean_profit = profit.mean()
std_profit = profit.std()
n = len(profit)

for confidence in [0.90, 0.95, 0.99]:

    z = stats.norm.ppf(
        1 - (1 - confidence) / 2
    )

    margin = (
        z * std_profit / np.sqrt(n)
    )

    lower = mean_profit - margin
    upper = mean_profit + margin

    print(
        f"{int(confidence * 100)}% Confidence Interval:"
    )

    print(
        "Lower:",
        lower,
        "Upper:",
        upper
    )


