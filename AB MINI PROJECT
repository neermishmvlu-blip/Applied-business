# ============================================================
# 16. EXPONENTIAL SMOOTHING
# ============================================================

print("\n========== EXPONENTIAL SMOOTHING ==========")

from statsmodels.tsa.holtwinters import ExponentialSmoothing

model_exp = ExponentialSmoothing(
    monthly_sales,
    trend="add",
    seasonal=None
)

fit_exp = model_exp.fit()

forecast_exp = fit_exp.forecast(3)

print("Next 3 Months Forecast:")

print(forecast_exp)


# ============================================================
# 17. FORECAST ACCURACY
# ============================================================

actual = monthly_sales.iloc[-3:]

predicted = fit_exp.fittedvalues.iloc[-3:]

mae = mean_absolute_error(
    actual,
    predicted
)

mse = mean_squared_error(
    actual,
    predicted
)

rmse = np.sqrt(mse)

print("\n========== FORECAST ACCURACY ==========")

print("MAE:", mae)
print("MSE:", mse)
print("RMSE:", rmse)


